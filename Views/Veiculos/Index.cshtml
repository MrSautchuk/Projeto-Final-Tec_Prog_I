@if (User.IsInRole("Gerente"))
{
    <partial name="_MenuGerente" />
}
else
{
    <partial name="_MenuVendedor" />
}
@model IEnumerable<GestaoGaragem.Models.Veiculo>

@{
    ViewData["Title"] = "Veículos";
}

<div class="container card p-4 border-0 shadow-sm mb-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #2e2e37;">Veículos</h2>
        <a asp-action="Create" class="btn text-white fw-bold" style="background-color: #e0121a; border: none;">
            <i class="bi bi-plus-circle"></i> Cadastrar Novo Veículo
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-borderless table-hover align-middle">
            <thead class="border-bottom text-muted">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Marca)</th>
                <th>@Html.DisplayNameFor(model => model.Modelo)</th>
                <th>Ano Fab/Mod</th>
                <th>@Html.DisplayNameFor(model => model.Placa)</th>
                <th>@Html.DisplayNameFor(model => model.Valor)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Marca)</td>
                    <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                    <td>@item.AnoFabricacao / @item.AnoModelo</td>
                    <td>@Html.DisplayFor(modelItem => item.Placa)</td>
                    <td>@item.Valor.ToString("C")</td>
                    <td>
                        <span class="badge @(item.Status == "Disponível" || item.Status == "Disponivel" ? "bg-success" : "bg-secondary")">
                            @Html.DisplayFor(modelItem => item.Status)
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                            <button type="button" class="btn btn-sm btn-info text-white" data-bs-toggle="modal" data-bs-target="#modalDetalhes-@item.Id">Detalhes</button>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                        </div>
                    </td>
                </tr>

                <!-- Modal Detalhes -->
                <div class="modal fade" id="modalDetalhes-@item.Id" tabindex="-1" aria-labelledby="modalDetalhesLabel-@item.Id" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title fw-bold text-uppercase" id="modalDetalhesLabel-@item.Id">@item.Marca @item.Modelo</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body pt-3 text-start">
                                <div class="row">
                                    <div class="col-md-7 mb-3 mb-md-0">
                                        @if (!string.IsNullOrEmpty(item.FotoBase64))
                                        {
                                            <img src="data:image/jpeg;base64,@item.FotoBase64" class="img-fluid rounded" style="width: 100%; max-height: 350px; object-fit: cover;" alt="@item.Modelo" />
                                        }
                                        else
                                        {
                                            <img src="https://placehold.co/600x400?text=Sem+Foto" class="img-fluid rounded" style="width: 100%; max-height: 350px; object-fit: cover;" alt="Sem foto" />
                                        }
                                    </div>
                                    <div class="col-md-5">
                                        <h3 class="text-danger fw-bold mb-4">@item.Valor.ToString("C")</h3>
                                        
                                        <ul class="list-group list-group-flush mb-4">
                                            <li class="list-group-item px-0 d-flex justify-content-between">
                                                <span class="text-muted">Marca</span>
                                                <span class="fw-bold">@item.Marca</span>
                                            </li>
                                            <li class="list-group-item px-0 d-flex justify-content-between">
                                                <span class="text-muted">Modelo</span>
                                                <span class="fw-bold">@item.Modelo</span>
                                            </li>
                                            <li class="list-group-item px-0 d-flex justify-content-between">
                                                <span class="text-muted">Ano Fab/Mod</span>
                                                <span class="fw-bold">@item.AnoFabricacao / @item.AnoModelo</span>
                                            </li>
                                            <li class="list-group-item px-0 d-flex justify-content-between">
                                                <span class="text-muted">Placa</span>
                                                <span class="fw-bold">@item.Placa</span>
                                            </li>
                                            <li class="list-group-item px-0 d-flex justify-content-between border-bottom-0">
                                                <span class="text-muted">Status</span>
                                                <span class="badge @(item.Status == "Disponível" || item.Status == "Disponivel" ? "bg-success" : "bg-secondary")">
                                                    @Html.DisplayFor(modelItem => item.Status)
                                                </span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
    </div>
</div>