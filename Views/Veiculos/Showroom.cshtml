@if (User.IsInRole("Gerente"))
{
    <partial name="_MenuGerente" />
}
else
{
    <partial name="_MenuVendedor" />
}
@model IEnumerable<GestaoGaragem.Models.Veiculo>

@{
    ViewData["Title"] = "Showroom";
}

<style>
    .wm-card {
        border: none;
        border-radius: 8px;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .wm-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .wm-price {
        color: #2e2e37;
    }
    .btn-wm-primary {
        background-color: #e0121a;
        border-color: #e0121a;
        color: white;
        font-weight: 600;
    }
    .btn-wm-primary:hover {
        background-color: #c01016;
        border-color: #c01016;
        color: white;
    }
    .btn-wm-outline {
        border: 1px solid #d1d5db;
        color: #4b5563;
        font-weight: 600;
    }
    .btn-wm-outline:hover {
        background-color: #f3f5f8;
        color: #1a1a1a;
    }
</style>

<div class="container mb-4 mt-3">
    <h1 class="fw-bold" style="color: #2e2e37;">Showroom de Veículos</h1>
    <p class="text-muted">Confira os veículos disponíveis para venda em nossa garagem.</p>
</div>

<div class="container row row-cols-1 row-cols-md-3 g-4 mb-5 mx-auto">
    @foreach (var item in Model) {
        <div class="col">
            <div class="card h-100 wm-card shadow-sm bg-white">
                @if (!string.IsNullOrEmpty(item.FotoBase64))
                {
                    <img src="data:image/jpeg;base64,@item.FotoBase64" class="card-img-top" style="height: 200px; object-fit: cover; border-top-left-radius: 8px; border-top-right-radius: 8px;" alt="@item.Modelo" />
                }
                else
                {
                    <img src="https://placehold.co/600x400?text=Sem+Foto" class="card-img-top" style="height: 200px; object-fit: cover; border-top-left-radius: 8px; border-top-right-radius: 8px;" alt="Sem foto" />
                }
                
                <div class="card-body">
                    <h5 class="card-title text-uppercase fw-bold mb-1" style="color: #2e2e37;">@item.Marca @item.Modelo</h5>
                    <p class="card-text text-muted mb-3"><small>@item.AnoFabricacao / @item.AnoModelo</small></p>
                    <div class="wm-price fs-3 fw-bold mb-0">@item.Valor.ToString("C")</div>
                </div>
                
                <div class="card-footer bg-transparent border-0 pt-0 pb-3 d-flex justify-content-between gap-2">
                    <button type="button" class="btn btn-wm-outline flex-fill" data-bs-toggle="modal" data-bs-target="#modalDetalhes-@item.Id">
                        Detalhes
                    </button>
                    <button type="button" class="btn btn-wm-primary flex-fill text-center" data-bs-toggle="modal" data-bs-target="#modalVenda-@item.Id">
                        Iniciar Venda
                    </button>
                </div>
            </div>
        </div>

        <!-- Modal Detalhes -->
        <div class="modal fade" id="modalDetalhes-@item.Id" tabindex="-1" aria-labelledby="modalDetalhesLabel-@item.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-uppercase" id="modalDetalhesLabel-@item.Id">@item.Marca @item.Modelo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-3">
                        <div class="row">
                            <div class="col-md-7 mb-3 mb-md-0">
                                @if (!string.IsNullOrEmpty(item.FotoBase64))
                                {
                                    <img src="data:image/jpeg;base64,@item.FotoBase64" class="img-fluid rounded" style="width: 100%; max-height: 350px; object-fit: cover;" alt="@item.Modelo" />
                                }
                                else
                                {
                                    <img src="https://placehold.co/600x400?text=Sem+Foto" class="img-fluid rounded" style="width: 100%; max-height: 350px; object-fit: cover;" alt="Sem foto" />
                                }
                            </div>
                            <div class="col-md-5">
                                <h3 class="text-danger fw-bold mb-4">@item.Valor.ToString("C")</h3>
                                
                                <ul class="list-group list-group-flush mb-4">
                                    <li class="list-group-item px-0 d-flex justify-content-between">
                                        <span class="text-muted">Marca</span>
                                        <span class="fw-bold">@item.Marca</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between">
                                        <span class="text-muted">Modelo</span>
                                        <span class="fw-bold">@item.Modelo</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between">
                                        <span class="text-muted">Ano Fab/Mod</span>
                                        <span class="fw-bold">@item.AnoFabricacao / @item.AnoModelo</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between">
                                        <span class="text-muted">Placa</span>
                                        <span class="fw-bold">@item.Placa</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between border-bottom-0">
                                        <span class="text-muted">Status</span>
                                        <span class="badge bg-success">@item.Status</span>
                                    </li>
                                </ul>
                                
                                <div class="d-grid">
                                    <button type="button" class="btn btn-wm-primary" data-bs-toggle="modal" data-bs-target="#modalVenda-@item.Id" data-bs-dismiss="modal">
                                        Iniciar Venda
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Iniciar Venda -->
        <div class="modal fade" id="modalVenda-@item.Id" tabindex="-1" aria-labelledby="modalVendaLabel-@item.Id" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold" id="modalVendaLabel-@item.Id">Vender: @item.Marca @item.Modelo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-controller="Vendas" asp-action="Create" method="post">
                        <div class="modal-body pt-3">
                            <input type="hidden" name="VeiculoId" value="@item.Id" />
                            <input type="hidden" name="UsuarioId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
                            <input type="hidden" name="DataVenda" value="@DateTime.Now.ToString("yyyy-MM-dd")" />

                            <div class="mb-3">
                                <label class="form-label text-muted fw-bold">Nome do Cliente</label>
                                <input type="text" name="NomeCliente" class="form-control" required placeholder="Nome Completo do Cliente" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted fw-bold">CPF do Cliente</label>
                                <input type="text" name="CpfCliente" class="form-control" required placeholder="000.000.000-00" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted fw-bold">Valor Final</label>
                                <input type="number" step="0.01" name="ValorFinal" class="form-control text-danger fw-bold" required value="@item.Valor.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-wm-primary">Confirmar Venda</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>